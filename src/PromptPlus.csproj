<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<AssemblyName>PromptPlus</AssemblyName>
		<RootNamespace>PromptPlusLibrary</RootNamespace>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<Configurations>Debug;Release;ReleaseDoc</Configurations>
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="Resources\PromptPlusResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>PromptPlusResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\PromptPlusResources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>PromptPlusResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<PropertyGroup>
		<Authors>Fernando Cerqueira</Authors>
		<Description>A .NET library that makes it easier to create beautiful, cross platform, console applications with powerful controls and commands to create professional console applications.</Description>
		<PackageReleaseNotes>https://github.com/FRACerqueira/PromptPlus/releases</PackageReleaseNotes>
		<PackageTags>cli;console;terminal;csharp;command;command-line;dotnet;prompt;Spectre.Console;Sharprompt</PackageTags>
		<RepositoryUrl>https://github.com/FRACerqueira/PromptPlus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageId>PromptPlus</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/FRACerqueira/PromptPlus</PackageProjectUrl>
		<Version>6.0.0-rc2</Version>
		<PackageIcon>icon.png</PackageIcon>
		<Copyright>© 2026 - Fernando Cerqueira</Copyright>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>PromptPlus</Title>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\NugetREADME.md">
			<Pack>True</Pack>
			<PackagePath>README.md</PackagePath>
		</None>
		<None Include="..\README.md" Link="README.md" />
		<None Include="..\README.txt">
			<Pack>True</Pack>
			<PackagePath>README.txt</PackagePath>
		</None>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'ReleaseDoc' and '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="DefaultDocumentation" Version="1.2.5">
			<!-- <PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>. -->
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<!-- Enables FileHistory to be tested against a MockFileSystem instead of the real user profile. -->
		<PackageReference Include="System.IO.Abstractions" Version="*" />
		<PackageReference Include="ConsolePlus.net" Version="1.0.0-rc2" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseDoc' and '$(TargetFramework)' == 'net10.0'">
		<DefaultDocumentationFolder>..\docs\api</DefaultDocumentationFolder>
		<DefaultDocumentationGeneratedPages>Assembly, Namespaces , Classes, Interfaces, Events, Enums, Structs, Delegates</DefaultDocumentationGeneratedPages>
		<DefaultDocumentationFileNameFactory>NameAndMd5Mix</DefaultDocumentationFileNameFactory>
		<DefaultDocumentationGeneratedAccessModifiers>Public</DefaultDocumentationGeneratedAccessModifiers>
		<DefaultDocumentationAssemblyPageName>PromptPlus</DefaultDocumentationAssemblyPageName>
		<DocIconUrl>https://raw.githubusercontent.com/FRACerqueira/PromptPlus/main/icon.png</DocIconUrl>
		<DocIconWidth>120</DocIconWidth>
	</PropertyGroup>

	<UsingTask TaskName="PrependDocIconHeader" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<DocsFolder Required="true" />
			<IconUrl Required="true" />
			<IconWidth />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					if (Directory.Exists(DocsFolder))
					{
						string width = string.IsNullOrEmpty(IconWidth) ? "120" : IconWidth;
						string header = "<img src=\"" + IconUrl + "\" width=\"" + width + "\" alt=\"PromptPlus\" />";
						foreach (string file in Directory.GetFiles(DocsFolder, "*.md"))
						{
							string content = File.ReadAllText(file);
							if (content.StartsWith(header, StringComparison.Ordinal))
							{
								continue;
							}
							File.WriteAllText(file, header + Environment.NewLine + Environment.NewLine + content);
						}
					}
				]]>
			</Code>
		</Task>
	</UsingTask>
	<Target Name="AddDocIconHeader" AfterTargets="DefaultDocumentation" Condition="'$(Configuration)' == 'ReleaseDoc' and '$(TargetFramework)' == 'net10.0'">
		<PropertyGroup>
			<_DocIconFolder>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(DefaultDocumentationFolder)'))))</_DocIconFolder>
		</PropertyGroup>
		<PrependDocIconHeader DocsFolder="$(_DocIconFolder)" IconUrl="$(DocIconUrl)" IconWidth="$(DocIconWidth)" />
		<Message Importance="high" Text="DefaultDocumentation: added icon header to markdown pages in $(_DocIconFolder)" />
	</Target>
</Project>
